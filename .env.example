# =============================================================================
# OpenRSVP Configuration
# =============================================================================
# Copy this file to .env and customize for your deployment.

# Server
PORT=8080
# Keep ENV=production for any deployment that other people can reach.
# ENV=development does three things that are unsafe in the open:
#   - it writes the magic link token and the verify URL to the log,
#   - it removes the Secure flag from the session cookie,
#   - it lets webhooks call private network addresses.
# Magic link is the only way to sign in, so log access equals account access.
# The docker compose stack sets ENV=development on its own, because it serves
# plain HTTP on localhost.
ENV=production
# ENV=development

# Database
DB_DRIVER=sqlite
DB_DSN=/data/openrsvp.db
# For PostgreSQL:
# DB_DRIVER=postgres
# DB_DSN=postgres://user:pass@localhost:5432/openrsvp?sslmode=disable
# When using docker-compose.postgres.yml, the following must be set
# (the compose file refuses to start without them):
# POSTGRES_USER=openrsvp
# POSTGRES_PASSWORD=change-me-to-something-strong
# POSTGRES_DB=openrsvp

# Auth
MAGIC_LINK_EXPIRY=15m
SESSION_EXPIRY=168h
BASE_URL=http://localhost:8080

# OpenID Connect sign-in (optional)
# When OIDC_ISSUER_URL is set, OIDC is the only way for organizers to sign in
# and magic links are turned off. Register this callback URL with the provider:
#   <BASE_URL>/api/v1/auth/oidc/callback
# Leave OIDC_CLIENT_SECRET empty for a public client (PKCE only).
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Only members of one of these groups (from the "groups" claim) may sign in.
# OIDC_ALLOWED_GROUPS=openrsvp
# OIDC_PROVIDER_NAME=Pocket ID

# Email Notifications
# Provider: smtp, sendgrid, ses
NOTIFICATION_EMAIL_PROVIDER=smtp

# SMTP settings (used when provider=smtp)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@openrsvp.local

# SendGrid settings (used when provider=sendgrid)
# SENDGRID_API_KEY=SG.xxxxx
# SENDGRID_FROM=noreply@yourdomain.com

# AWS SES settings (used when provider=ses)
# SES_REGION=us-east-1
# SES_USERNAME=your-ses-smtp-username
# SES_PASSWORD=your-ses-smtp-password
# SES_FROM=noreply@yourdomain.com

# Shared secret for the SendGrid and SES delivery webhooks. The routes
# /api/v1/notifications/webhooks/sendgrid and .../ses answer 404 for every
# request while this value is empty. Give the provider the URL with the
# secret appended, for example:
#   https://yourdomain.com/api/v1/notifications/webhooks/sendgrid?token=<secret>
# The value must be 32 characters or more. Generate one with:
#   openssl rand -hex 32
# WEBHOOK_SECRET=

# SMS Notifications (optional)
# Provider: twilio, vonage, sns
# NOTIFICATION_SMS_PROVIDER=twilio

# Twilio settings
# TWILIO_ACCOUNT_SID=ACxxxxx
# TWILIO_AUTH_TOKEN=xxxxx
# TWILIO_FROM_NUMBER=+15551234567

# Vonage settings
# VONAGE_API_KEY=xxxxx
# VONAGE_API_SECRET=xxxxx
# VONAGE_FROM=OpenRSVP

# Amazon SNS settings (used when provider=sns)
# SNS_SMS_REGION=us-east-1
# SNS_SMS_ACCESS_KEY_ID=AKIAxxxxx
# SNS_SMS_SECRET_ACCESS_KEY=xxxxx

# Feedback
# At least one channel must be configured or submissions are silently discarded.
#
# Option 1 — GitHub Issues (recommended): create a Personal Access Token with
# repo scope (classic) or Issues write permission (fine-grained), then set the
# target repo as "owner/repo".
# FEEDBACK_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# FEEDBACK_GITHUB_REPO=yourorg/yourrepo
#
# Option 2 — Email fallback: requires SMTP (or other email provider) to be configured.
# FEEDBACK_EMAIL=feedback@yourdomain.com

# Data Retention
DEFAULT_RETENTION_DAYS=30
